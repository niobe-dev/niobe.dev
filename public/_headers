# Headers for everything the asset store serves. They live here rather than in
# the worker because a request for a file does not run the worker at all — only
# /install.sh and /api/* do.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  # Nothing is inlined into the HTML — `vite.build.assetsInlineLimit` is zero —
  # so no inline script is allowed. The style exception covers the handful of
  # `style` attributes holding layout values computed at build time.
  Content-Security-Policy: default-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; upgrade-insecure-requests

# Hashed filenames, so they can be kept for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/og.png
  Cache-Control: public, max-age=86400
