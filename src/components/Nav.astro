import { site } from "../lib/site";

interface Props {
  /// Which top-level section the current page belongs to, so the bar can mark
  /// it. Undefined on pages that belong to none.
  section?: "docs" | "changelog";
}

const { section } = Astro.props;
---

<nav class="bar shell" aria-label="Main">
  <a class="bar__brand" href="/">
    <span class="mark"></span>NIOBE
  </a>
  <div class="bar__links">
    <a href="/docs" aria-current={section === "docs" ? "page" : undefined}>Docs</a>
    <a href="/#features">Features</a>
    <a href="/changelog" aria-current={section === "changelog" ? "page" : undefined}>
      Changelog
    </a>
  </div>
  <div class="bar__out">
    <a href={site.repoUrl} rel="noopener">GitHub ↗</a>
    <a href={site.issuesUrl} rel="noopener">Issues ↗</a>
    <a class="bar__cta" href="/docs/installation">$ install</a>
  </div>
</nav>
