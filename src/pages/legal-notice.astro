import { getEntry, render } from "astro:content";
import Legal from "../layouts/Legal.astro";

const entry = await getEntry("legal", "legal-notice");
if (!entry) throw new Error("src/content/legal/legal-notice.md is missing");
const { Content } = await render(entry);
---

<Legal
  title={entry.data.title}
  description={entry.data.description}
  updated={entry.data.updated}
  siblingHref="/privacy"
  siblingTitle="Privacy Policy / Datenschutzerklärung"
>
  <Content />
</Legal>
