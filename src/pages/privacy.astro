import { getEntry, render } from "astro:content";
import Legal from "../layouts/Legal.astro";

const entry = await getEntry("legal", "privacy");
if (!entry) throw new Error("src/content/legal/privacy.md is missing");
const { Content } = await render(entry);
---

<Legal
  title={entry.data.title}
  description={entry.data.description}
  updated={entry.data.updated}
  siblingHref="/legal-notice"
  siblingTitle="Legal Notice / Impressum"
>
  <Content />
</Legal>
