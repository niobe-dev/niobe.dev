{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niobe-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request runs the worker first, so `/install.sh` and `/api/*` can be
    // answered before the asset store is consulted.
    "run_worker_first": ["/install.sh", "/api/*"]
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "niobe.dev", "custom_domain": true },
    { "pattern": "www.niobe.dev", "custom_domain": true }
  ]
}
