{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "niobe-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // The pages link to `/docs/installation`, so that is the URL that
    // serves a page; the trailing-slash form redirects to it. The default
    // would redirect the other way and put a hop in front of every link.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // The worker sees every request except the fingerprinted files, which are
    // served straight from the edge. It needs the document requests to send
    // `www` to the apex — Workers' `_redirects` takes relative URLs only, so a
    // redirect between hostnames cannot live there.
    "run_worker_first": [
      "/*",
      "!/_astro/*",
      "!/fonts/*",
      "!/og.png",
      "!/icon-192.png",
      "!/icon-512.png",
      "!/apple-touch-icon.png",
      "!/favicon.svg",
      "!/favicon.ico"
    ]
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "niobe.dev", "custom_domain": true },
    // www is a route rather than a custom domain: the hostname already has a
    // DNS record of its own, and a custom domain refuses to replace one. A
    // route puts the worker in front of whatever that record points at, which
    // is all the redirect needs.
    { "pattern": "www.niobe.dev/*", "zone_name": "niobe.dev" }
  ]
}
